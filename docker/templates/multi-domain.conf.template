limit_req_zone $binary_remote_addr zone=waypoints_limit:16m rate=23r/s;
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=pdf_limit:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=search_limit:10m rate=120r/m;

limit_conn_zone $binary_remote_addr zone=discovery_perip:10m;
limit_conn_zone $server_name        zone=discovery_total:10m;

proxy_cache_path /var/cache/nginx/aspace levels=1:2 keys_zone=aspace_cache:16m max_size=512m inactive=10m use_temp_path=off;

map $http_cookie $aspace_skip_cache {
  default                     0;
  "~*archivesspace_session="  1;
}

map $args $safe_args {
  default        $args;
  "~*password="  "password=REDACTED";
}

map $args $aspace_doubleenc {
  default      "";
  "~*%252[Aa]" "doubleenc";
}
limit_req_zone $aspace_doubleenc zone=doubleenc_limit:10m rate=30r/m;

map $arg_page $aspace_deep_page {
  default        "";
  "~^[0-9]{3,}$" $binary_remote_addr;
}
limit_req_zone $aspace_deep_page zone=deeppage_limit:10m rate=20r/m;

map $arg_page $aspace_deep_page_logged {
  default        "";
  "~^[0-9]{3,}$" "1";
}

map "$http_referer|$http_x_forwarded_proto://$host$request_uri" $aspace_self_referer {
  default          "";
  "~^(.+)\|\1$"    "1";
}
limit_req_zone $aspace_self_referer zone=selfreferer_limit:10m rate=15r/m;

map $args $aspace_has_filter_fields {
  default        0;
  "~*filter_fields" 1;
}
map $http_cookie $aspace_has_session {
  default                          0;
  "~*_archivesspace-public_session" 1;
}
map "$aspace_has_filter_fields:$aspace_has_session" $aspace_facet_scrape {
  default   "";
  "1:0"     "scrape";
}
map "$aspace_has_filter_fields:$aspace_has_session" $aspace_facet_scrape_key {
  default   "";
  "1:0"     $binary_remote_addr;
}
limit_req_zone $aspace_facet_scrape_key zone=facetscrape_limit:10m rate=30r/m;

# Full-form-submission fingerprint: real narrow searches almost never populate every
# optional search-form field (including the blank ones) on every request; a scripted
# crawl re-submitting the whole form does. Order-independent (real samples vary).
map $args $aspace_form_scrape {
  default "";
  "~*^(?=.*field\[\])(?=.*filter_fields\[\])(?=.*from_year\[\])(?=.*op\[\])(?=.*sort=)(?=.*to_year\[\])" "formscrape";
}
limit_req_zone $aspace_form_scrape zone=formscrape_limit:10m rate=15r/m;

# Facet-filter params on a single-record detail page: filter_fields/filter_values only
# mean anything on a list/search view, never on one record's own page.
map $uri $aspace_is_detail_page {
  default 0;
  "~*^/repositories/\d+/(archival_objects|resources|digital_objects|classification_terms|top_containers)/\d+$" 1;
  "~*^/agents/(people|corporate_entities|families|software)/\d+$" 1;
  "~*^/subjects/\d+$" 1;
  "~*^/classifications/\d+$" 1;
}
map "$aspace_is_detail_page:$aspace_has_filter_fields" $aspace_detail_scrape {
  default "";
  "1:1"   "detailscrape";
}
limit_req_zone $aspace_detail_scrape zone=detailscrape_limit:10m rate=15r/m;

# Filter-chain depth: real users chain at most ~3 facet filters in one request; bots
# enumerating combinations chain far more. Path-agnostic (list or detail pages alike).
map $args $aspace_filter_chain {
  default "";
  "~*^(?:.*?filter_fields(?:\[\]|%5[bB]%5[dD])=){4,}" "filterchain";
}
limit_req_zone $aspace_filter_chain zone=filterchain_limit:10m rate=15r/m;

log_format sanitized '$remote_addr - $remote_user [$time_local] "$host" '
                      '"$request_method $uri$is_args$safe_args $server_protocol" '
                      '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                      'rt=$request_time uct="$upstream_response_time" cache=$upstream_cache_status '
                      'req_limit=$limit_req_status conn_limit=$limit_conn_status '
                      'skip_cache=$aspace_skip_cache doubleenc=$aspace_doubleenc deep_page=$aspace_deep_page_logged '
                      'self_referer=$aspace_self_referer facet_scrape=$aspace_facet_scrape '
                      'form_scrape=$aspace_form_scrape detail_scrape=$aspace_detail_scrape '
                      'filter_chain=$aspace_filter_chain';

limit_req_zone $binary_remote_addr zone=public_backstop:10m rate=20r/s;

upstream app_api {
  server ${UPSTREAM_HOST}:8089;
  keepalive 8;
}

upstream app_oai {
  server ${UPSTREAM_HOST}:8082;
  keepalive 8;
}

upstream app_public {
  server ${UPSTREAM_HOST}:8081;
  keepalive 8;
}

upstream app_staff {
  server ${UPSTREAM_HOST}:8080;
  keepalive 8;
}

server_names_hash_bucket_size 128;

server {
  server_name ${PUBLIC_NAME};
  set_real_ip_from ${REAL_IP_CIDR};
  include /etc/nginx/common-config;

  ${REDIRECT_BLOCK}

  ${ROOT_REDIRECT_BLOCK}

  location = / {
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_cache aspace_cache;
    proxy_cache_valid 200 120s;
    proxy_pass http://app_public;
  }

  location = /robots.txt {
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_cache aspace_cache;
    proxy_cache_valid 200 1h;
    proxy_pass http://app_public;
  }

  location ${PUBLIC_PREFIX} {
    ${PUI_IPS_ALLOWED};
    deny all;
    limit_req zone=public_backstop burst=200 nodelay;
    proxy_pass http://app_public;
  }

  location ~* (wp-admin|wp-includes|wp-content|wp-json|xmlrpc\.php|wp-login\.php|wp-config\.php|wp-cron\.php|wp-trackback\.php|wp-comments-post\.php|wp-links-opml\.php) {
      deny all;
  }

  location ~* \.(php|asp|aspx|cgi|action|dll|sh|bat|exe|jsp|jhtml|jsa|cfm|shtml)(\.(bak|old|save|orig|swp|tmp)|~)?$ {
    return 404;
  }

  location ~* ^/(webdav|sling|adminer|apisix|tcpdf|jkstatus|actuator|console|manager|solr|h2-console|jolokia|api/jsonws|_vti_bin|_vti_pvt|_vti_aut|_vti_inf|heapdump|graphql|geoserver|wls-wsat|autodiscover|owa|webui|versa|remote|scadabr|nifi|pandora_console|nidp|officescan|boaform|mailinspector|sap/bc) {
    return 404;
  }

  location ~* (javax\.faces\.resource|WEB-INF|META-INF) {
    return 404;
  }

  location ~* assets/.+\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|ico|map)$ {
    add_header Cache-Control "public, max-age=604800, immutable";
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_cache aspace_cache;
    proxy_cache_valid 200 1d;
    proxy_pass http://app_public;
  }

  location ~* ^/(advanced_)?search {
    include /etc/nginx/discovery-config;
    proxy_pass http://app_public;
  }

  location ~* ^/(repositories/resources|repositories/[0-9]+/(resources|objects|accessions|classifications|agents|subjects|digital_objects|search)|objects|agents|subjects|classifications|cite)(/?(\?|$)) {
    ${PUI_IPS_ALLOWED};
    deny all;
    include /etc/nginx/discovery-config;
    proxy_pass http://app_public;
  }

  location ~ ^/repositories/[0-9]+/resources/[0-9]+/pdf$ {
    limit_req zone=pdf_limit burst=4 nodelay;
    proxy_pass http://app_public;
  }

  location ~ ^/repositories/\d+/resources/\d+/infinite/waypoints {
    limit_req zone=waypoints_limit burst=100 delay=100;
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_cache aspace_cache;
    proxy_cache_valid 200 120s;
    proxy_pass http://app_public;
  }

  location ~ ^/(repositories/[0-9]+/(resources|objects|accessions|classifications|digital_objects|archival_objects)/[0-9]+|agents/(people|corporate_entities|families|software)/[0-9]+|subjects/[0-9]+|classifications/[0-9]+) {
    ${PUI_IPS_ALLOWED};
    deny all;
    include /etc/nginx/discovery-config;
    proxy_pass http://app_public;
  }

  location ${OAI_PREFIX} {
    ${PUI_IPS_ALLOWED};
    deny all;
    proxy_pass http://app_oai/;
  }
}

server {
  server_name ${STAFF_NAME};
  set_real_ip_from ${REAL_IP_CIDR};
  include /etc/nginx/common-config;

  location ~* \.(php|asp|aspx|cgi|action|dll|sh|bat|exe|jsp|jhtml|jsa|cfm|shtml)(\.(bak|old|save|orig|swp|tmp)|~)?$ {
    return 404;
  }

  location ~* ^/(webdav|sling|adminer|apisix|tcpdf|jkstatus|actuator|console|manager|solr|h2-console|jolokia|api/jsonws|_vti_bin|_vti_pvt|_vti_aut|_vti_inf|heapdump|graphql|geoserver|wls-wsat|autodiscover|owa|webui|versa|remote|scadabr|nifi|pandora_console|nidp|officescan|boaform|mailinspector|sap/bc) {
    return 404;
  }

  location ~* (javax\.faces\.resource|WEB-INF|META-INF) {
    return 404;
  }

  location ~* assets/.+\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|ico|map)$ {
    add_header Cache-Control "public, max-age=604800, immutable";
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_cache aspace_cache;
    proxy_cache_valid 200 1d;
    proxy_pass http://app_staff;
  }

  location = /staff/login {
    limit_req zone=login_limit burst=10 nodelay;
    ${SUI_IPS_ALLOWED};
    deny all;
    add_header Cache-Control "no-store" always;
    add_header Pragma "no-cache" always;
    proxy_pass http://app_staff;
  }

  location ${STAFF_PREFIX} {
    ${SUI_IPS_ALLOWED};
    deny all;
    add_header Cache-Control "no-store" always;
    add_header Pragma "no-cache" always;
    proxy_pass http://app_staff;
  }

  location ${API_PREFIX} {
    ${API_IPS_ALLOWED};
    deny all;
    proxy_pass http://app_api/;
  }
}
